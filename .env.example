# ==============================================================================
# WANDERLY / TRAVELHOLIC ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI (REQUIRED FOR REAL ITINERARY PLANNING & MISSIONS)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/app/apikey
# Powers real-time itinerary generation, route calibration, checkpoint missions.
GEMINI_API_KEY=

# (Optional Alternative: OpenAI)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. SUPABASE CLOUD DATABASE & AUTH (REQUIRED FOR REAL CLOUD PERSISTENCE)
# ------------------------------------------------------------------------------
# Create a free project at: https://supabase.com
# Execute the SQL schema migration in Supabase SQL Editor:
#   supabase/migrations/20261010000000_initial_wanderly_schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. GOOGLE MAPS / GEOCODING (OPTIONAL)
# ------------------------------------------------------------------------------
# Wanderly automatically connects to Google Maps Tiles and OpenStreetMap Nominatim
# for global geocoding out of the box. Add a Google Maps key if you want official
# Google Places / Geocoding API responses:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 4. MOCK FALLBACK OVERRIDE
# ------------------------------------------------------------------------------
# Set to 'true' only if you want offline fallback templates when no API key is set.
# Default is 'false' (strict mode: requires real Gemini API key).
ALLOW_MOCK_FALLBACK=false
